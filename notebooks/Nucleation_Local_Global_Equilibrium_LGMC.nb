Cell["\<\
Apparently, the system needs to overcome a nucleation barrier to achieve \
global equilibrium.\
\>", "Text",
 CellChangeTimes->{{3.993991456613411*^9, 
  3.993991490023958*^9}},ExpressionUUID->"a8d13e09-7698-4e8a-a2c6-\
cdeb1613514f"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Concentration versus ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[CapitalDelta]\[Mu]", TraditionalForm], 
     "errors" -> {}, "input" -> "\\Delta \\mu", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5f2386b1-30d9-485a-8250-801dec4666a3"],
 " starting from a configuration containing a \
\[OpenCurlyDoubleQuote]nucleation seed\[CloseCurlyDoubleQuote]\
\[CloseCurlyDoubleQuote]"
}], "Subsection",
 CellChangeTimes->{{3.9939880084385242`*^9, 3.9939880579663258`*^9}, {
  3.993991547760214*^9, 
  3.993991564593583*^9}},ExpressionUUID->"06f3825f-55eb-4ee1-9e7f-\
ba90617f8408"],

Cell[TextData[{
 "The function ",
 StyleBox["sweepBranchWithNuclei ",
  FontVariations->{"Underline"->True}],
 " is similar to ",
 StyleBox["sweepBranch",
  FontVariations->{"Underline"->True}],
 " ",
 ", except that it uses a \[OpenCurlyDoubleQuote]seed configuration at each \
new value of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[CapitalDelta]\[Mu]", TraditionalForm], 
     "errors" -> {}, "input" -> "\\Delta \\mu", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d24e5e10-3c05-454a-8234-ecdeaa69b94f"],
 ". At each  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[CapitalDelta]\[Mu]", TraditionalForm], 
     "errors" -> {}, "input" -> "\\Delta \\mu", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "940daac7-da20-4ad3-86ee-d589613688e0"],
 "., the configuration looks like:"
}], "Text",
 CellChangeTimes->{{3.9939916453789797`*^9, 
  3.9939917918748293`*^9}},ExpressionUUID->"0a8d292e-b078-48ec-8159-\
1a0186819cda"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"#", "|", " ", 
    RowBox[{"label", ":", " ", "fig", ":", 
     RowBox[{"seed", "-", "configuration"}]}]}], " ", "*)"}], "\n", 
  RowBox[{"drawLattice", "[", "\[IndentingNewLine]", 
   RowBox[{"ArrayPad", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Which", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"i", "-", "35"}], ")"}], "^", "2"}], " ", "+", " ", 
           RowBox[{"j", "^", "2"}]}], " ", "<=", " ", "50"}], ",", "1", ",", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"i", "+", "35"}], ")"}], "^", "2"}], " ", "+", " ", 
           RowBox[{"j", "^", "2"}]}], " ", "<=", " ", "50"}], ",", 
         RowBox[{"-", "1"}], ",", "True", ",", "0"}], " ", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"-", "100"}], ",", "100"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", 
         RowBox[{"-", "100"}], ",", "100"}], "}"}]}], "]"}], ",", "1"}], 
    "\[IndentingNewLine]", "]"}], "]"}]}]], "Input",
 CellChangeTimes->{3.9939918124273376`*^9},
 CellLabel->"In[28]:=",ExpressionUUID->"a79de7bd-07a5-4bbd-90dd-be783635de5c"],

