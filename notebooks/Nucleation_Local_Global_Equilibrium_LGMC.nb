Notebook[{
Cell["\<\
(* Load the LatticeGasMC package.  The path is resolved for both contexts \
this
   notebook has to run in: the Wolfram front end, where NotebookDirectory[] \
is
   defined, and the headless kernel the MyST wolfram plugin drives, where it is
   not (wolframscript runs from the book root instead). *)
latticeGasLibraryPath = SelectFirst[
   {Quiet@Check[
     FileNameJoin[{NotebookDirectory[], \"library\", \"LatticeGasMC.wl\"}], \
$Failed],
    FileNameJoin[{Directory[], \"notebooks\", \"library\", \
\"LatticeGasMC.wl\"}],
    FileNameJoin[{Directory[], \"library\", \"LatticeGasMC.wl\"}]},
   StringQ[#] && FileExistsQ[#] &,
   $Failed];
If[latticeGasLibraryPath === $Failed,
  Print[\"LatticeGasMC.wl not found; looked next to the notebook and under \
\",
    Directory[]];
  Abort[],
  Get[latticeGasLibraryPath]];\
\>", "Input",
 InitializationCell->
  True,ExpressionUUID->"43376507-8d1f-4f18-be04-48fafea70e46"],

Cell[BoxData[
 RowBox[{
  RowBox[{"deltaMuValues", " ", "=", " ", 
   RowBox[{"Range", "[", 
    RowBox[{
     RowBox[{"-", "2.0"}], ",", " ", "2.0", ",", " ", "0.2"}], "]"}]}], 
  ";"}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.993991103968882*^9, 3.993991104314967*^9}},
 CellLabel->"In[10]:=",ExpressionUUID->"a88f479c-3d51-431e-bb87-73df769e61f9"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"orangeFraction", "[", "config_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"counts", " ", "=", " ", 
       RowBox[{"latticeGasSpeciesCounts", "[", "config", "]"}]}], "}"}], ",", 
     "\n", "   ", 
     RowBox[{
      RowBox[{"counts", "[", "\"\<orange\>\"", "]"}], "/", 
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{"counts", "[", "\"\<orange\>\"", "]"}], " ", "+", " ", 
        RowBox[{"counts", "[", "\"\<blue\>\"", "]"}]}], "]"}]}]}], "]"}]}], 
  ";"}]], "Input",
 InitializationCell->True,
 CellLabel->"In[11]:=",ExpressionUUID->"f89699fd-868f-485b-b737-cc1b6ade2a4b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "sweepBranch", "]"}], "=", " ", 
   RowBox[{"{", 
    RowBox[{"\"\<Metropolis Iterations\>\"", "->", 
     RowBox[{"2", " ", 
      RowBox[{"10", "^", "6"}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sweepBranch", "[", 
    RowBox[{"deltas_", ",", " ", 
     RowBox[{"OptionsPattern", "[", 
      RowBox[{"{", 
       RowBox[{"latticeGasBulkExchangeSweep", ",", "sweepBranch"}], "}"}], 
      "]"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"config", ",", " ", 
       RowBox[{"branch", " ", "=", " ", 
        RowBox[{"<|", "|>"}]}], ",", " ", 
       RowBox[{"configurations", "=", 
        RowBox[{"<|", "|>"}]}]}], "}"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"config", " ", "=", " ", 
       RowBox[{"latticeGasRandomConfiguration", "[", 
        RowBox[{"64", ",", " ", "64", ",", " ", "1850", ",", " ", "1850"}], 
        "]"}]}], ";", "\n", "   ", 
      RowBox[{"Do", "[", "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"config", ",", " ", "statistics"}], "}"}], " ", "=", " ", 
          "\[IndentingNewLine]", 
          RowBox[{"latticeGasBulkExchangeSweep", "[", 
           RowBox[{"config", ",", " ", 
            RowBox[{
            "OptionValue", "[", "\"\<Metropolis Iterations\>\"", "]"}], ",", 
            "\n", "       ", 
            RowBox[{"\"\<energyNearest\>\"", " ", "->", " ", 
             RowBox[{"OptionValue", "[", "\"\<energyNearest\>\"", "]"}]}], 
            ",", "\[IndentingNewLine]", 
            RowBox[{"\"\<energyNextNearest\>\"", " ", "->", " ", 
             RowBox[{"OptionValue", "[", "\"\<energyNextNearest\>\"", "]"}]}],
             ",", "\[IndentingNewLine]", " ", 
            RowBox[{"\"\<muOrange\>\"", " ", "->", " ", 
             RowBox[{"1.", " ", "+", " ", 
              RowBox[{"deltaMu", "/", "2"}]}]}], " ", ",", 
            "\[IndentingNewLine]", 
            RowBox[{"\"\<muBlue\>\"", " ", "->", " ", 
             RowBox[{"1.", " ", "-", " ", 
              RowBox[{"deltaMu", "/", "2."}]}]}], ",", "\[IndentingNewLine]", 
            " ", 
            RowBox[{"\"\<inverseTemperature\>\"", " ", "->", " ", 
             RowBox[{
             "OptionValue", "[", "\"\<inverseTemperature\>\"", "]"}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"\"\<exchangeProbability\>\"", "->", 
             RowBox[{
             "OptionValue", "[", "\"\<exchangeProbability\>\"", "]"}]}]}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"AssociateTo", "[", 
          RowBox[{"configurations", ",", " ", 
           RowBox[{"deltaMu", "->", "config"}]}], "]"}], ";", "\n", "    ", 
         RowBox[{"AssociateTo", "[", 
          RowBox[{"branch", ",", " ", 
           RowBox[{"deltaMu", "->", 
            RowBox[{"orangeFraction", "[", "config", "]"}]}]}], "]"}]}], ",", 
        "\n", "    ", 
        RowBox[{"{", 
         RowBox[{"deltaMu", ",", " ", "deltas"}], "}"}]}], "]"}], ";", "\n", 
      " ", 
      RowBox[{"{", "  ", 
       RowBox[{"branch", ",", "configurations"}], "}"}]}]}], "]"}]}], 
  ";"}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.993988160212582*^9, 3.993988173077667*^9}, {
   3.9939882680322933`*^9, 3.99398828068093*^9}, 3.9939883679493313`*^9, 
   3.993988456673798*^9, {3.993988580947153*^9, 3.993988691034685*^9}, {
   3.993990263039365*^9, 3.993990279904261*^9}},
 CellLabel->"In[13]:=",ExpressionUUID->"3ac441ae-3c2e-40c6-abd8-a44ac66c6a1b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "sweepBranchWithNuclei", "]"}], "=", " ", 
   RowBox[{"{", 
    RowBox[{"\"\<Metropolis Iterations\>\"", "->", 
     RowBox[{"2", " ", 
      RowBox[{"10", "^", "6"}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sweepBranchWithNuclei", "[", 
    RowBox[{"deltas_", ",", " ", 
     RowBox[{"OptionsPattern", "[", 
      RowBox[{"{", 
       RowBox[{"latticeGasBulkExchangeSweep", ",", "sweepBranchWithNuclei"}], 
       "}"}], "]"}]}], "]"}], " ", ":=", " ", "\[IndentingNewLine]", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"config", ",", "origConfig", ",", " ", 
       RowBox[{"branch", " ", "=", " ", 
        RowBox[{"<|", "|>"}]}], ",", " ", 
       RowBox[{"configurations", "=", 
        RowBox[{"<|", "|>"}]}], ",", " ", "statistics"}], "}"}], ",", "\n", 
     "   ", 
     RowBox[{
      RowBox[{"config", " ", "=", 
       RowBox[{"origConfig", "=", " ", 
        RowBox[{"ArrayPad", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Table", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Which", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"i", "-", "35"}], ")"}], "^", "2"}], " ", "+", " ", 
                
                RowBox[{"j", "^", "2"}]}], " ", "<=", " ", "50"}], ",", "1", 
              ",", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"i", "+", "35"}], ")"}], "^", "2"}], " ", "+", " ", 
                
                RowBox[{"j", "^", "2"}]}], " ", "<=", " ", "50"}], ",", 
              RowBox[{"-", "1"}], ",", "True", ",", "0"}], " ", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", 
              RowBox[{"-", "100"}], ",", "100"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", 
              RowBox[{"-", "100"}], ",", "100"}], "}"}]}], "]"}], ",", "1"}], 
         "\[IndentingNewLine]", "]"}]}]}], ";", "\n", "   ", 
      RowBox[{"Do", "[", "\n", "   ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"config", ",", "statistics"}], "}"}], "=", " ", 
          RowBox[{"latticeGasBulkExchangeSweep", "[", 
           RowBox[{"config", ",", " ", 
            RowBox[{
            "OptionValue", "[", "\"\<Metropolis Iterations\>\"", "]"}], ",", 
            "\n", "       ", 
            RowBox[{"\"\<energyNearest\>\"", " ", "->", " ", 
             RowBox[{"OptionValue", "[", "\"\<energyNearest\>\"", "]"}]}], 
            ",", "\[IndentingNewLine]", 
            RowBox[{"\"\<energyNextNearest\>\"", " ", "->", " ", 
             RowBox[{"OptionValue", "[", "\"\<energyNextNearest\>\"", "]"}]}],
             ",", "\[IndentingNewLine]", "  ", 
            RowBox[{"\"\<muOrange\>\"", " ", "->", " ", 
             RowBox[{"1.", " ", "+", " ", 
              RowBox[{"deltaMu", "/", "2"}]}]}], " ", ",", 
            "\[IndentingNewLine]", 
            RowBox[{"\"\<muBlue\>\"", " ", "->", " ", 
             RowBox[{"1.", " ", "-", " ", 
              RowBox[{"deltaMu", "/", "2."}]}]}], ",", "\[IndentingNewLine]", 
            " ", 
            RowBox[{"\"\<inverseTemperature\>\"", " ", "->", " ", 
             RowBox[{
             "OptionValue", "[", "\"\<inverseTemperature\>\"", "]"}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"\"\<exchangeProbability\>\"", "->", 
             RowBox[{
             "OptionValue", "[", "\"\<exchangeProbability\>\"", "]"}]}]}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"AssociateTo", "[", 
          RowBox[{"configurations", ",", " ", 
           RowBox[{"deltaMu", "->", "config"}]}], "]"}], ";", "\n", "    ", 
         RowBox[{"AssociateTo", "[", 
          RowBox[{"branch", ",", " ", 
           RowBox[{"deltaMu", "->", 
            RowBox[{"orangeFraction", "[", "config", "]"}]}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"config", "=", " ", "origConfig"}]}], ",", "\n", "    ", 
        RowBox[{"{", 
         RowBox[{"deltaMu", ",", " ", "deltas"}], "}"}]}], "]"}], ";", "\n", 
      " ", 
      RowBox[{"{", "  ", 
       RowBox[{"branch", ",", "configurations"}], "}"}]}]}], "]"}]}], 
  ";"}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.993987967193782*^9, 3.9939879720098057`*^9}, {
   3.9939887117385893`*^9, 3.993988776787086*^9}, 3.993992102743375*^9, {
   3.99399238046906*^9, 3.993992390237596*^9}},
 CellLabel->"In[16]:=",ExpressionUUID->"3ed90155-2fa9-470f-892b-45e6a0bcca46"],

Cell[CellGroupData[{

Cell["\<\
Global and Local Equilibrium:
Nucleation and Hysteresis in the Lattice Gas Metropolis Model\
\>", "Chapter",
 CellChangeTimes->{{3.993983422593746*^9, 3.993983468202016*^9}, {
  3.993992533700328*^9, 
  3.993992551956036*^9}},ExpressionUUID->"fd59601e-d2fe-4865-8a27-\
8571170e7e43"],

Cell[TextData[{
 "Each value of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalDelta]\[Mu]", "\[LongEqual]", 
         SubscriptBox["\[Mu]", 
          StyleBox["O", "TI"]], "-", 
         SubscriptBox["\[Mu]", 
          StyleBox["B", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\Delta \\mu = \\mu_{O} - \\mu_{B}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6523b767-d754-4eac-9c73-e87215fc0586"],
 " has an equilibrium concentration. "
}], "Text",
 CellChangeTimes->{{3.993983488276864*^9, 3.993983502221859*^9}, {
  3.9939835396324577`*^9, 3.99398374904388*^9}, {3.993983814809626*^9, 
  3.993983815541995*^9}, {3.993983865700156*^9, 
  3.993983866136443*^9}},ExpressionUUID->"c1ff8d67-8474-4118-bba9-\
417ab58525cd"],

Cell[TextData[{
 "We probe the concentrations by iteratively finding the concentration as we \
sweep along values of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[CapitalDelta]\[Mu]", TraditionalForm], 
     "errors" -> {}, "input" -> "\\Delta \\mu", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "eb42800e-785b-4235-bcb0-f9c8a29f2610"],
 ". \n\nIn this case, we will probe the behavior for the case where there are \
two disordered phases separated by a miscibility gap.  This is the classic \
case of a phase diagram associated with spinodal decomposition.\n",
