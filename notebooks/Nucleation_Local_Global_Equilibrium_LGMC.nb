Cell["\<\
So, there is a small seed to help the system get over the nucleation barrier.

Here is the experiment:\
\>", "Text",
 CellChangeTimes->{{3.993991827574623*^9, 
  3.993991860756093*^9}},ExpressionUUID->"a52a9500-ec19-4db7-97b1-\
b56288bde4a4"],

Cell[TextData[{
 "Increasing ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[CapitalDelta]\[Mu]", TraditionalForm], 
     "errors" -> {}, "input" -> "\\Delta \\mu", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7bc968f5-0735-47ad-a21a-9a2aeac84781"],
 ":"
}], "Text",
 CellChangeTimes->{{3.993989660732513*^9, 3.9939896658731337`*^9}, {
  3.993989740522737*^9, 3.9939897474098*^9}, {3.993989796368186*^9, 
  3.9939898307783318`*^9}, {3.993991915892267*^9, 
  3.9939919177906637`*^9}},ExpressionUUID->"eb9f7ea2-ffc8-4754-81a4-\
5eaf50c6f2a2"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"upBranchWithNuclei", ",", " ", "upConfigurationsWithNuclei"}], 
    "}"}], " ", "=", " ", 
   RowBox[{"sweepBranchWithNuclei", "[", 
    RowBox[{"deltaMuValues", ",", "\[IndentingNewLine]", 
     RowBox[{"\"\<Metropolis Iterations\>\"", "->", 
      RowBox[{"2", " ", 
       RowBox[{"10", "^", "6"}]}]}], ",", "\[IndentingNewLine]", " ", 
     RowBox[{"\"\<energyNearest\>\"", " ", "->", " ", 
      RowBox[{"-", "1.0"}]}], ",", "\[IndentingNewLine]", " ", 
     RowBox[{"\"\<energyNextNearest\>\"", " ", "->", " ", 
      RowBox[{"-", "0.4"}]}], ",", "\n", 
     RowBox[{"\"\<inverseTemperature\>\"", " ", "->", " ", 
      RowBox[{"1", "/", "1.2"}]}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.99398963711419*^9, 3.9939896453865137`*^9}, {
  3.993991955945512*^9, 3.993991970835905*^9}},
 CellLabel->"In[29]:=",ExpressionUUID->"711093ba-3157-4677-9fe1-bb4aea025d1c"],

Cell[TextData[{
 "Decreasing ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[CapitalDelta]\[Mu]", TraditionalForm], 
     "errors" -> {}, "input" -> "\\Delta \\mu", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5236e484-e718-41d0-9e34-e39d8b8891a4"],
 ":"
}], "Text",
 CellChangeTimes->{{3.993989660732513*^9, 3.9939896658731337`*^9}, {
  3.993989740522737*^9, 3.9939897474098*^9}, {3.993989796368186*^9, 
  3.9939898307783318`*^9}, {3.993991915892267*^9, 
  3.9939919329274387`*^9}},ExpressionUUID->"01b4752a-0dd3-4ab9-a9ac-\
157054bd1784"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
    "downBranchWithNuclei", ",", " ", "downConfigurationsWithNuclei"}], "}"}],
    "=", " ", 
   RowBox[{"sweepBranchWithNuclei", "[", 
    RowBox[{
     RowBox[{"Reverse", "[", "deltaMuValues", "]"}], ",", 
     RowBox[{"\"\<Metropolis Iterations\>\"", "->", 
      RowBox[{"2", " ", 
       RowBox[{"10", "^", "6"}]}]}], ",", "\[IndentingNewLine]", " ", 
     RowBox[{"\"\<energyNearest\>\"", " ", "->", " ", 
      RowBox[{"-", "1.0"}]}], ",", "\[IndentingNewLine]", " ", 
     RowBox[{"\"\<energyNextNearest\>\"", " ", "->", " ", 
      RowBox[{"-", "0.4"}]}], ",", "\n", 
     RowBox[{"\"\<inverseTemperature\>\"", " ", "->", " ", 
      RowBox[{"1", "/", "1.2"}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.99398963711419*^9, 3.9939896453865137`*^9}, {
  3.993991923749898*^9, 3.993991980273616*^9}},
 CellLabel->"In[30]:=",ExpressionUUID->"4e757053-815e-4a54-8c46-18c428833cae"],

