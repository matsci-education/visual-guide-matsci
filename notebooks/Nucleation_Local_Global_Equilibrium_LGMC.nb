Cell[TextData[{
 "Observe that there are two concentrations for a range of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[CapitalDelta]\[Mu]", TraditionalForm], 
     "errors" -> {}, "input" -> "\\Delta \\mu", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4ebfcf89-24b6-492b-b486-4cb57e257048"],
 ".  The system cannot be in a global equilibrium.  We can visualize why:"
}], "Text",
 CellChangeTimes->{{3.99399037522404*^9, 3.993990418207502*^9}, {
  3.9939908661400747`*^9, 
  3.9939909161056547`*^9}},ExpressionUUID->"1b88543a-65b0-45da-b73c-\
7b60aa354190"],

Cell[TextData[{
 "The function ",
 StyleBox["sweepBranch",
  FontVariations->{"Underline"->True}],
 " takes a list of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[CapitalDelta]\[Mu]", TraditionalForm], 
     "errors" -> {}, "input" -> "\\Delta \\mu", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4e357ac9-4b88-4dcd-aff9-762acce4182d"],
 "\[CloseCurlyQuote]s  iterates at each ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[CapitalDelta]\[Mu]", TraditionalForm], 
     "errors" -> {}, "input" -> "\\Delta \\mu", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7deea6ce-ba34-4b84-b45b-b12fb63468a9"],
 " enough iterations to have confidence the system has reached a (local) \
equilibrium."
}], "Text",
 CellChangeTimes->{
  3.99399158742592*^9},ExpressionUUID->"1d2176e6-29e4-41dc-8a20-af7bfc6c4abb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"#", "|", " ", 
    RowBox[{"label", ":", " ", "fig", ":", 
     RowBox[{"sweep", "-", "explorer", "-", "random"}]}]}], " ", "*)"}], "\n", 
  RowBox[{"DynamicModule", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"micro", " ", "=", 
       RowBox[{"drawLattice", "[", 
        RowBox[{
         RowBox[{"downConfigurations", "[", 
          RowBox[{"[", 
           RowBox[{"-", "1"}], "]"}], "]"}], ",", 
         RowBox[{"ImageSize", "->", "400"}]}], "]"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"inset", "=", " ", 
       RowBox[{"Show", "[", 
        RowBox[{"llp", ",", 
         RowBox[{"Graphics", "[", 
          RowBox[{"{", 
           RowBox[{"Black", ",", 
            RowBox[{"PointSize", "[", "0.05", "]"}], ",", 
            RowBox[{"Point", "[", 
             RowBox[{"upBranch", "[", 
              RowBox[{"[", 
               RowBox[{"-", "1"}], "]"}], "]"}], "]"}]}], "}"}], "]"}], ",", 
         RowBox[{"ImageSize", "->", "300"}]}], "]"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"upBranchPairs", "=", " ", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Keys", "[", "upBranch", "]"}], ",", 
          RowBox[{"Values", "[", "upBranch", "]"}]}], "}"}], "]"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"downBranchPairs", "=", " ", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Keys", "[", "downBranch", "]"}], ",", 
          RowBox[{"Values", "[", "downBranch", "]"}]}], "}"}], "]"}]}]}], 
     "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"Which", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"direction", "==", "\"\<down\>\""}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"micro", " ", "=", 
           RowBox[{"drawLattice", "[", 
            RowBox[{
             RowBox[{"downConfigurations", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", 
             RowBox[{"ImageSize", "->", "200"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"inset", " ", "=", " ", 
           RowBox[{"Show", "[", 
            RowBox[{"llp", ",", 
             RowBox[{"Graphics", "[", 
              RowBox[{"{", 
               RowBox[{"Black", ",", 
                RowBox[{"PointSize", "[", "0.05", "]"}], ",", 
                RowBox[{"Point", "[", 
                 RowBox[{"downBranchPairs", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "]"}]}], "}"}], "]"}], ",", 
             
             RowBox[{"ImageSize", "->", "300"}]}], "]"}]}], ";"}], ",", 
         "\[IndentingNewLine]", "True", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"micro", " ", "=", 
           RowBox[{"drawLattice", "[", 
            RowBox[{
             RowBox[{"upConfigurations", "[", 
              RowBox[{"[", 
               RowBox[{"-", "i"}], "]"}], "]"}], ",", 
             RowBox[{"ImageSize", "->", "200"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"inset", " ", "=", " ", 
           RowBox[{"Show", "[", 
            RowBox[{"llp", ",", 
             RowBox[{"Graphics", "[", 
              RowBox[{"{", 
               RowBox[{"Black", ",", 
                RowBox[{"PointSize", "[", "0.05", "]"}], ",", 
                RowBox[{"Point", "[", 
                 RowBox[{"upBranchPairs", "[", 
                  RowBox[{"[", 
                   RowBox[{"-", "i"}], "]"}], "]"}], "]"}]}], "}"}], "]"}], 
             ",", 
             RowBox[{"ImageSize", "->", "300"}]}], "]"}]}]}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"GraphicsRow", "[", 
        RowBox[{"{", 
         RowBox[{"micro", ",", "inset"}], "}"}], "]"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", 
        RowBox[{"Length", "[", "downConfigurations", "]"}], ",", "1"}], "}"}],
       ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"direction", ",", "\"\<down\>\""}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\"\<down\>\"", ",", "\"\<up\>\""}], "}"}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"SaveDefinitions", "->", "True"}]}], "\[IndentingNewLine]", 
     "]"}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.993990994581854*^9, 3.993991004187188*^9}, {
   3.993991043099257*^9, 3.993991066715406*^9}, 3.993991207399192*^9, {
