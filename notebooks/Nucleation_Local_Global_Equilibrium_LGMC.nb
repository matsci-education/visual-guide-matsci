Cell[TextData[{
 "We will sweep over these values of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[CapitalDelta]\[Mu]", TraditionalForm], 
     "errors" -> {}, "input" -> "\\Delta \\mu", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a2f2e630-6190-490c-b552-c146bd14be0e"],
 ":"
}], "Text",
 CellChangeTimes->{{3.993989769783197*^9, 
  3.993989793731168*^9}},ExpressionUUID->"a871eea4-8da2-4185-8cd3-\
013e167ba759"],

Cell[CellGroupData[{

Cell[BoxData["deltaMuValues"], "Input",
 CellLabel->"In[23]:=",ExpressionUUID->"ab27dfc6-1edc-4901-94a2-7f61e4ea4e88"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"-", "2.`"}], ",", 
   RowBox[{"-", "1.8`"}], ",", 
   RowBox[{"-", "1.6`"}], ",", 
   RowBox[{"-", "1.4`"}], ",", 
   RowBox[{"-", "1.2`"}], ",", 
   RowBox[{"-", "1.`"}], ",", 
   RowBox[{"-", "0.7999999999999999`"}], ",", 
   RowBox[{"-", "0.5999999999999999`"}], ",", 
   RowBox[{"-", "0.3999999999999999`"}], ",", 
   RowBox[{"-", "0.1999999999999999`"}], ",", "1.1102230246251565`*^-16", ",",
    "0.20000000000000012`", ",", "0.40000000000000013`", ",", 
   "0.6000000000000001`", ",", "0.8000000000000002`", ",", 
   "1.0000000000000002`", ",", "1.2000000000000002`", ",", 
   "1.4000000000000001`", ",", "1.6`", ",", "1.8000000000000003`", ",", 
   "2.`"}], "}"}]], "Output",
 CellChangeTimes->{3.996304778873629*^9, 3.996304991146286*^9},
 CellLabel->"Out[23]=",ExpressionUUID->"d744a17d-ff73-470f-872c-5bac6b04f6f6"]
}, Open  ]],

Cell[TextData[{
 "First, we start from the negative values and increment to towards positive ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[CapitalDelta]\[Mu]", TraditionalForm], 
     "errors" -> {}, "input" -> "\\Delta \\mu", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cd93d1a4-f0a5-4d01-ba6b-1ce2424ce783"],
 ":"
}], "Text",
 CellChangeTimes->{{3.993989660732513*^9, 3.9939896658731337`*^9}, {
  3.993989740522737*^9, 3.9939897474098*^9}, {3.993989796368186*^9, 
  3.9939898307783318`*^9}},ExpressionUUID->"1965c042-0c08-457c-9f51-\
266c736f233f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"upBranch", ",", " ", "upConfigurations"}], "}"}], " ", "=", " ", 
   
   RowBox[{"sweepBranch", "[", 
    RowBox[{"deltaMuValues", ",", "\[IndentingNewLine]", 
     RowBox[{"\"\<Metropolis Iterations\>\"", "->", 
      RowBox[{"2", " ", 
       RowBox[{"10", "^", "6"}]}]}], ",", "\[IndentingNewLine]", " ", 
     RowBox[{"\"\<energyNearest\>\"", " ", "->", " ", 
      RowBox[{"-", "1.0"}]}], ",", "\[IndentingNewLine]", " ", 
     RowBox[{"\"\<energyNextNearest\>\"", " ", "->", " ", 
      RowBox[{"-", "0.4"}]}], ",", "\n", 
     RowBox[{"\"\<inverseTemperature\>\"", " ", "->", " ", 
      RowBox[{"1", "/", "1.2"}]}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.99398963711419*^9, 3.9939896453865137`*^9}},
 CellLabel->"In[24]:=",ExpressionUUID->"2cb3bfe1-b2ea-412d-8ef3-850e7215f813"],

Cell[TextData[{
 "Next, we start from the positive values and increment to towards negative \
",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[CapitalDelta]\[Mu]", TraditionalForm], 
     "errors" -> {}, "input" -> "\\Delta \\mu", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c012718f-6340-4e40-9722-c61110585563"],
 ":"
}], "Text",
 CellChangeTimes->{{3.993989660732513*^9, 3.9939896658731337`*^9}, {
   3.993989740522737*^9, 3.9939897474098*^9}, {3.993989796368186*^9, 
   3.9939898658550377`*^9}, 
   3.993992111996358*^9},ExpressionUUID->"ede8bfbd-d5d1-46d6-a655-\
6bb7d704639c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"downBranch", ",", " ", "downConfigurations"}], "}"}], "=", " ", 
   RowBox[{"sweepBranch", "[", 
    RowBox[{
     RowBox[{"Reverse", "[", "deltaMuValues", "]"}], ",", 
     RowBox[{"\"\<Metropolis Iterations\>\"", "->", 
      RowBox[{"2", " ", 
       RowBox[{"10", "^", "6"}]}]}], ",", "\[IndentingNewLine]", " ", 
     RowBox[{"\"\<energyNearest\>\"", " ", "->", " ", 
      RowBox[{"-", "1.0"}]}], ",", "\[IndentingNewLine]", " ", 
     RowBox[{"\"\<energyNextNearest\>\"", " ", "->", " ", 
      RowBox[{"-", "0.4"}]}], ",", "\n", 
     RowBox[{"\"\<inverseTemperature\>\"", " ", "->", " ", 
      RowBox[{"1", "/", "1.2"}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.99398963711419*^9, 3.9939896453865137`*^9}},
 CellLabel->"In[25]:=",ExpressionUUID->"b8413837-e267-4d8c-80e1-6882e22d18d4"],

