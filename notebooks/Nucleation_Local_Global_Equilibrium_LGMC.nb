 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"#", "|", " ", 
    RowBox[{"label", ":", " ", "fig", ":", 
     RowBox[{"demo", "-", "lattice"}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{"drawLattice", "[", 
