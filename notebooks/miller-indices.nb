Notebook[{
Cell["Miller Indices", "Title",ExpressionUUID->"efb9bc37-85d0-4676-b152-929bd4164914"],

Cell["\<\
A lattice plane is named by its Miller indices (hkl). Take the intercepts the \
plane makes with the three crystal axes, measured in lattice constants, \
invert them, and clear any fractions. A zero index means the plane never \
meets that axis - it runs parallel to it.\
\>", "Text",ExpressionUUID->"2051c079-1395-4ad3-aa2c-9488b149e353"],

Cell["The (111) plane cuts all three axes at one lattice constant:", "Text",ExpressionUUID->"df0e06f5-8f34-4f23-8f46-2c3bd8961176"],

Cell[BoxData[
 Graphics3DBox[{
   {Opacity[0.12], EdgeForm[{GrayLevel[0.5], Thickness[Tiny]}], 
    CuboidBox[{0, 0, 0}]}, 
   {RGBColor[0.2, 0.45, 0.8], Opacity[0.55], 
    Polygon3DBox[{{1, 0, 0}, {0, 1, 0}, {0, 0, 1}}]}, 
   {RGBColor[0.85, 0.2, 0.2], PointSize[0.03], 
    Point3DBox[{{1, 0, 0}, {0, 1, 0}, {0, 0, 1}}]}},
  Axes->True,
  AxesLabel->{
    FormBox["\"a\"", TraditionalForm], 
    FormBox["\"b\"", TraditionalForm], 
    FormBox["\"c\"", TraditionalForm]},
  Boxed->True,
  ImageSize->340,
  Lighting->"Neutral",
  ViewPoint->{2., -2.2, 1.5}]], "Output",ExpressionUUID->"c3e9a9ed-9661-4431-\
8ef9-ed7cc5ff0843"],

Cell["\<\
The (110) plane is parallel to the c axis, so it cuts only a and b:\
\>", "Text",ExpressionUUID->"3ba09949-d1bd-4d4d-a51d-be938a214933"],

Cell[BoxData[
 Graphics3DBox[{
   {Opacity[0.12], EdgeForm[{GrayLevel[0.5], Thickness[Tiny]}], 
    CuboidBox[{0, 0, 0}]}, 
   {RGBColor[0.2, 0.45, 0.8], Opacity[0.55], 
    Polygon3DBox[{{1, 0, 0}, {0, 1, 0}}]}, 
   {RGBColor[0.85, 0.2, 0.2], PointSize[0.03], 
    Point3DBox[{{1, 0, 0}, {0, 1, 0}}]}},
  Axes->True,
  AxesLabel->{
    FormBox["\"a\"", TraditionalForm], 
    FormBox["\"b\"", TraditionalForm], 
    FormBox["\"c\"", TraditionalForm]},
  Boxed->True,
  ImageSize->340,
  Lighting->"Neutral",
  ViewPoint->{2., -2.2, 1.5}]], "Output",ExpressionUUID->"3d44639d-d1bf-4999-\
b58f-58c436b5c7bd"],

Cell["\<\
Try other index sets by editing and evaluating the input below.\
\>", "Text",ExpressionUUID->"cefa1d9d-fa09-4815-be1a-2b8e584ec15a"],

Cell["draw[1, 0, 0]", "Input",ExpressionUUID->"3a054f15-949a-42a6-85a5-9145f01e5860"]
},
FrontEndVersion->"14.3 for Mac OS X ARM (64-bit) (July 8, 2025)",
